{
  "name": "liubai-storage-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "python scripts/launch_report.py --open",
    "serve:legacy": "node server/service.mjs",
    "report": "python scripts/launch_report.py",
    "build:report": "node scripts/build-report.mjs",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node integrations/mcp.mjs",
    "cli": "node integrations/cli.mjs",
    "dev": "npm run build:report && npm start",
    "build": "vite build",
    "preview": "python scripts/launch_report.py --preview --open"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": { "vite": "^7.2.0" }
}
